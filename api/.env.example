PORT=3000

# --- Auth (required) ---
# HTTP Basic Auth credentials guarding every route except /health.
BASIC_AUTH_USERNAME=otorres
BASIC_AUTH_PASSWORD=change-me

# --- AWS ---
# Region for Bedrock, S3, and S3 Vectors. Local dev uses your default AWS credentials.
AWS_REGION=us-east-1

# --- Filled in from CDK stack outputs as later steps land ---
# DOCS_BUCKET_NAME=...
# VECTOR_BUCKET_NAME=...
# VECTOR_INDEX_NAME=...
# EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# CHAT_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
