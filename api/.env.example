PORT=3000

# --- Auth (required) ---
# HTTP Basic Auth credentials guarding every route except /health.
BASIC_AUTH_USERNAME=otorres
BASIC_AUTH_PASSWORD=change-me

# --- CORS ---
# Origins allowed to call the API from a browser (comma-separated, or * for any).
# For local dev the Vite frontend runs on http://localhost:5173.
CORS_ORIGINS=*

# --- AWS ---
# Region + named profile for Bedrock, S3, and S3 Vectors (local dev credentials).
AWS_REGION=us-east-1
# AWS_PROFILE=dev

# --- Filled in from CDK stack outputs ---
# DOCS_BUCKET_NAME=...
# VECTOR_BUCKET_NAME=...
# VECTOR_INDEX_NAME=...
# EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Claude Haiku 4.5 requires the us. cross-region inference profile id (not the bare model id):
# CHAT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
