# Copy to infra/.env and fill in. These become the Lambda's env vars.

# --- Auth (BASIC_AUTH_PASSWORD is required; synth fails without it) ---
BASIC_AUTH_USERNAME=otorres
BASIC_AUTH_PASSWORD=change-me

# --- Bedrock models (optional; these are the defaults) ---
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Claude Haiku 4.5 requires the us. cross-region inference profile id:
CHAT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# --- Frontend CORS (optional) ---
# Browser origins allowed to call the API. Defaults to the stack's CloudFront origin.
# Set a comma-separated list to also allow local dev, e.g.:
# CORS_ORIGINS=https://dxxxx.cloudfront.net,http://localhost:5173
